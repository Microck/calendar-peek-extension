{
  "manifest_version": 3,
  "name": "Calendar Peek",
  "short_name": "Cal Peek",
  "version": "0.2.1",
  "minimum_chrome_version": "111",
  "description": "See a coworker's Google Calendar availability from Google Workspace or Slack with one click.",
  "key": "",
  "permissions": [
    "alarms",
    "identity",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://calendar.google.com/*",
    "https://mail.google.com/*",
    "https://drive.google.com/*",
    "https://docs.google.com/*",
    "https://meet.google.com/*",
    "https://chat.google.com/*",
    "https://contacts.google.com/*",
    "https://*.slack.com/*",
    "https://www.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options/options.html",
  "action": {
    "default_title": "View coworker calendar",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://calendar.google.com/*"
      ],
      "js": [
        "src/common.js",
        "src/calendar.js",
        "src/profile-card.js"
      ],
      "css": [
        "src/styles.css"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "https://mail.google.com/*",
        "https://drive.google.com/*",
        "https://docs.google.com/*",
        "https://meet.google.com/*",
        "https://chat.google.com/*",
        "https://contacts.google.com/*"
      ],
      "js": [
        "src/common.js",
        "src/profile-card.js"
      ],
      "css": [
        "src/styles.css"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "https://*.slack.com/*"
      ],
      "js": [
        "src/common.js",
        "src/availability-utils.js",
        "src/slack.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
